# Surf Data API key — copy this file to `.env` and fill in.
# Never commit `.env`. Rotate the key if it ever appears in a git diff, log,
# browser devtools, or a chat transcript.
SURF_API_KEY=sk-surf-replace-me

# Optional: local proxy port (default 3999).
PORT=3999

# Optional: override Surf base URL (only change for staging / enterprise).
SURF_BASE=https://api.asksurf.ai/gateway/v1
