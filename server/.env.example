# Environment
NODE_ENV=development
PORT=3002
DATABASE_URL="postgresql://postgres:1234qwer@localhost:5432/lokacash"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
LOKA_AI_API_KEY=your_loka_ai_api_key
LOKA_AI_BASE_URL=your_loka_ai_base_url
LOKA_AI_MODEL=your_loka_ai_model
# 图片路由摘要专用模型（用于 routeImageDigest）；不设则沿用 LOKA_AI_MODEL
# 例：claude-sonnet-4-6
# LOKA_AI_IMAGE_DIGEST_MODEL=claude-sonnet-4-6
# 股票分析 JSONL 里 tool_start/tool_done 的 displayName：auto（随用户语言）| en | zh。设 en 则 Thinking Process 工具步骤始终英文
# STOCK_ANALYSIS_TOOL_DISPLAY_LANG=en
# Signal Radar 合成：默认流式输出；若网关不支持 SSE 设为 false
# LOKA_AI_STREAM=true
FRONTEND_URL=http://localhost:3000
TRUSTMRR_API_KEY=your_trustmrr_api_key

# Cloudflare R2 Config
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_r2_bucket_name"
R2_PUBLIC_DOMAIN="your_r2_public_domain"

# Stripe API Key Encryption (32 bytes = 64 hex chars)
STRIPE_ENCRYPTION_KEY=your_stripe_encryption_key

# Deep Research Agent (last30days)
EXA_API_KEY=your_exa_api_key
SCRAPECREATORS_API_KEY=your_scrapecreators_api_key
#BSKY_HANDLE=your_bsky_handle
#BSKY_APP_PASSWORD=fbs3-k6h3-ooaq-lvqg
AUTH_TOKEN=your_auth_token
CT0=your_ct0
# last30days（SuperAgent deep search）：不设 LAST30DAYS_SOURCES 时默认只跑 X（--sources x，不跑 Reddit）；有 EXA 时仍会加 --include-web
# 需要 Reddit：LAST30DAYS_SOURCES=auto
# LAST30DAYS_SOURCES=auto
# last30days 会请求 OpenAI 官方 GET /v1/models；兼容网关密钥常返回 403。设置后可跳过错误并避免误用 gpt-5-mini 回退名
# 与 LOKA_AI_MODEL 或网关上实际存在的模型 id 对齐
# OPENAI_MODEL_PIN=deepseek-v3

# Web3 / Super Agent — CoinGecko MCP（tools/web3）；不设则走公共 MCP，失败时用公开 REST
# COINGECKO_PRO_API_KEY=your_coingecko_pro_demo_or_pro_key
# COINGECKO_MCP_URL=https://mcp.pro-api.coingecko.com/mcp

# iFlytek Speech Recognition
IFLYTEK_APPID=your_iflytek_appid
IFLYTEK_API_SECRET=your_iflytek_api_secret
IFLYTEK_API_KEY=your_iflytek_api_key

# Multi-Agent Consensus Engine
CONSENSUS_API_BASE=your_consensus_api_base



# ===================================
# Search Service
# ===================================
TAVILY_API_KEYS=your_tavily_api_key
SEARXNG_PUBLIC_INSTANCES_ENABLED=true
# 若公共 SearXNG 经常 429，可设为 1 禁用（会强制关闭 public + self-hosted searx）
# STOCK_ANALYSIS_DISABLE_SEARXNG=1
# 若 SerpAPI 经常超时/代理失败，可设为 1 禁用 SerpAPI 搜索
# STOCK_ANALYSIS_DISABLE_SERPAPI=1
# 若要测试非 Agent（headless）路径，可设为 1（默认 0，保持现有 Agent 流式模式）
# STOCK_ANALYSIS_FORCE_HEADLESS=1
ANSPIRE_API_KEYS=your_anspire_api_key
BOCHA_API_KEYS=your_bocha_api_key
SERPAPI_API_KEYS=your_serpapi_api_key

# ===================================
# Daily Stock Analysis 
# ===================================
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.lingyaai.cn/v1
LITELLM_MODEL=openai/deepseek-v3


ENABLE_FUNDAMENTAL_PIPELINE=true
ENABLE_REALTIME_QUOTE=true
ENABLE_REALTIME_TECHNICAL_INDICATORS=true
ENABLE_CHIP_DISTRIBUTION=true
ENABLE_EASTMONEY_PATCH=true


AGENT_MODE=true
AGENT_ARCH=single

# SuperAgent：设为 1 可关闭 HTML 报告生成（investment-analysis / guru-council / roundtable），用于对比是否拖慢整体
# SUPERAGENT_DISABLE_HTML_REPORT=1
AGENT_ORCHESTRATOR_MODE=standard    


