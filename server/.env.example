# Environment
NODE_ENV=development
# 仅开发：设为 true 时任意非空邀请码均可通过（生产环境无效）
# INVITATION_GATE_DISABLED=true
PORT=3002
DATABASE_URL="postgresql://postgres:1234qwer@localhost:5432/lokacash"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
LOKA_AI_API_KEY=your_loka_ai_api_key
LOKA_AI_BASE_URL=your_loka_ai_base_url
LOKA_AI_MODEL=your_loka_ai_model
# 最终总结（Synthesis）专用模型；不设则沿用 LOKA_AI_MODEL
# 例：claude-sonnet-4-6
# LOKA_AI_SYNTHESIS_MODEL=claude-sonnet-4-6
# 图片路由摘要专用模型（用于 routeImageDigest）；不设则沿用 LOKA_AI_MODEL
# 例：claude-sonnet-4-6
# LOKA_AI_IMAGE_DIGEST_MODEL=claude-sonnet-4-6
# 股票分析 JSONL 里 tool_start/tool_done 的 displayName：auto（随用户语言）| en | zh。设 en 则 Thinking Process 工具步骤始终英文
# STOCK_ANALYSIS_TOOL_DISPLAY_LANG=en
# Signal Radar 合成：默认流式输出；若网关不支持 SSE 设为 false
# LOKA_AI_STREAM=true
FRONTEND_URL=http://localhost:3000
# CoinGecko simple/price 单次请求超时（毫秒），默认 25000；启动瞬间并发多时易踩 10s 线
# COINGECKO_FETCH_TIMEOUT_MS=40000
# Node 的 fetch 不读 macOS 系统代理；需代理访问 api.coingecko.com 时请设置（端口按你本机代理改）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# last30days / Bird（X 搜索）子进程同样读上述代理；秒，默认 quick=45 / default=60 / deep=90
# BIRD_SEARCH_TIMEOUT_QUICK=60
# BIRD_SEARCH_TIMEOUT_DEFAULT=90
# BIRD_SEARCH_TIMEOUT_DEEP=120
TRUSTMRR_API_KEY=your_trustmrr_api_key
# 设为 false / 0 / no / off 时关闭启动时全量 Boot Sync 与定时列表刷新（本地减负；Discover 无 TrustMRR 缓存直至重新开启）
# TRUSTMRR_ENABLED=false

# Cloudflare R2 Config
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_r2_bucket_name"
R2_PUBLIC_DOMAIN="your_r2_public_domain"

# Stripe API Key Encryption (32 bytes = 64 hex chars)
STRIPE_ENCRYPTION_KEY=your_stripe_encryption_key

# Deep Research Agent (last30days)
EXA_API_KEY=your_exa_api_key
SCRAPECREATORS_API_KEY=your_scrapecreators_api_key
#BSKY_HANDLE=your_bsky_handle
#BSKY_APP_PASSWORD=fbs3-k6h3-ooaq-lvqg
AUTH_TOKEN=your_auth_token
CT0=your_ct0
# last30days（SuperAgent deep search）：不设 LAST30DAYS_SOURCES 时默认只跑 X（--sources x，不跑 Reddit）；有 EXA 时仍会加 --include-web
# 需要 Reddit：LAST30DAYS_SOURCES=auto
# LAST30DAYS_SOURCES=auto
# SuperAgent 搜索加速：限制 last30days 仅跑指定源（逗号分隔）。默认内部使用 x,web
# 可选值示例：x,web / reddit,x,web / web / x,hn
# SUPERAGENT_LAST30DAYS_SEARCH=x,web
# last30days 会请求 OpenAI 官方 GET /v1/models；兼容网关密钥常返回 403。设置后可跳过错误并避免误用 gpt-5-mini 回退名
# 与 LOKA_AI_MODEL 或网关上实际存在的模型 id 对齐
# OPENAI_MODEL_PIN=deepseek-v3

# Web3 / Super Agent — CoinGecko MCP（tools/web3）；不设则走公共 MCP，失败时用公开 REST
# COINGECKO_PRO_API_KEY=your_coingecko_pro_demo_or_pro_key
# COINGECKO_MCP_URL=https://mcp.pro-api.coingecko.com/mcp

# iFlytek Speech Recognition
IFLYTEK_APPID=your_iflytek_appid
IFLYTEK_API_SECRET=your_iflytek_api_secret
IFLYTEK_API_KEY=your_iflytek_api_key

# Multi-Agent Consensus Engine
CONSENSUS_API_BASE=your_consensus_api_base



# ===================================
# Search Service
# ===================================
TAVILY_API_KEYS=your_tavily_api_key
SEARXNG_PUBLIC_INSTANCES_ENABLED=true
# 若公共 SearXNG 经常 429，可设为 1 禁用（会强制关闭 public + self-hosted searx）
# STOCK_ANALYSIS_DISABLE_SEARXNG=1
# 若 SerpAPI 经常超时/代理失败，可设为 1 禁用 SerpAPI 搜索
# STOCK_ANALYSIS_DISABLE_SERPAPI=1
# 若要测试非 Agent（headless）路径，可设为 1（默认 0，保持现有 Agent 流式模式）
# STOCK_ANALYSIS_FORCE_HEADLESS=1
ANSPIRE_API_KEYS=your_anspire_api_key
BOCHA_API_KEYS=your_bocha_api_key
SERPAPI_API_KEYS=your_serpapi_api_key

# ===================================
# Daily Stock Analysis 
# ===================================
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.lingyaai.cn/v1
LITELLM_MODEL=openai/deepseek-v3


ENABLE_FUNDAMENTAL_PIPELINE=true
ENABLE_REALTIME_QUOTE=true
ENABLE_REALTIME_TECHNICAL_INDICATORS=true
ENABLE_CHIP_DISTRIBUTION=true
ENABLE_EASTMONEY_PATCH=true
# 关闭后将不初始化对应数据源（可用于规避 pytdx 资源警告 / tushare 配额问题）
# ENABLE_TUSHARE_FETCHER=false
# ENABLE_PYTDX_FETCHER=false


AGENT_MODE=true
AGENT_ARCH=single

# SuperAgent：设为 1 可关闭 HTML 报告生成（investment-analysis / guru-council / roundtable），用于对比是否拖慢整体
# SUPERAGENT_DISABLE_HTML_REPORT=1
# SuperAgent：设为 true/1/yes/on 时，输出 [agent:chat:synthesis_text] 最终合成全文日志；默认 false（不输出）
# SUPERAGENT_LOG_SYNTHESIS_TEXT=false
AGENT_ORCHESTRATOR_MODE=standard    


# ===================================
# Subscription — Stripe integration
# ===================================
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxx
STRIPE_PRICE_MAX_MONTHLY=price_xxxxx
STRIPE_PRICE_MAX_YEARLY=price_xxxxx
# 测试网地址
APP_URL=https://testlokacash.vercel.app
# 主网地址
#APP_URL=https://www.loka.cash

# ===================================
# Subscription — Plan quotas & display pricing (env-driven; no code edit)
# Rolling window length is per-plan; Free resets weekly, Pro/Max monthly.
# The *_USD values are DISPLAY-ONLY — real billing is Stripe's Price IDs
# above. Keep them in sync so users see the same price they pay.
# Frontend reads all of this via GET /api/config/public — no duplication.
# ===================================
PLAN_FREE_FAST=20
PLAN_FREE_ROUNDTABLE=3
PLAN_FREE_WINDOW_DAYS=7

PLAN_PRO_FAST=300
PLAN_PRO_ROUNDTABLE=75
PLAN_PRO_WINDOW_DAYS=30
PLAN_PRO_MONTHLY_USD=49
PLAN_PRO_YEARLY_USD=489

PLAN_MAX_FAST=800
PLAN_MAX_ROUNDTABLE=225
PLAN_MAX_WINDOW_DAYS=30
PLAN_MAX_MONTHLY_USD=109
PLAN_MAX_YEARLY_USD=1087

# ===================================
# Guest mode (unauthenticated Auto-only access)
# Set ENABLE_GUEST_MODE=false to revert to login-required behavior.
# GUEST_AUTO_LIMIT applies per guestId (localStorage UUID); IP cap catches
# abusers who clear localStorage to farm quota.
# ===================================
ENABLE_GUEST_MODE=true
GUEST_AUTO_LIMIT=5
GUEST_AUTO_WINDOW_HOURS=24
GUEST_IP_AUTO_LIMIT=30
GUEST_IP_AUTO_WINDOW_HOURS=24


